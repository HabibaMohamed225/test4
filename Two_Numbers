#include <iostream>
#include<cmath>
using namespace std;
void Two_Number(float n1,float n2){
    float div=n1/n2;
    cout<<"floor "<<n1<<" / "<<n2<<" = "<<floor(div)<<endl;
    cout<<"ceil "<<n1<<" / "<<n2<<" = "<<ceil(div)<<endl;
    cout<<"round "<<n1<<" / "<<n2<<" = "<<round(div)<<endl;
}
int main(){
    float n1,n2;
    cin>>n1>>n2;
    Two_Number(n1,n2);
    return 0;
}
